AI_MEMORY_VAULT=C:\Users\YOUR_NAME\Documents\Obsidian\AI-Memory
MEMORY_WRITER=chatgpt

# auto  = valid proposals are written immediately
# review = valid proposals wait in the dashboard review queue
MEMORY_WRITE_MODE=auto

# Optional transcript extractor:
MEMORY_LLM_BASE_URL=http://localhost:11434/v1
MEMORY_LLM_MODEL=
MEMORY_LLM_API_KEY=

# Optional local embeddings, used only for retrieval and semantic audit:
MEMORY_EMBED_BASE_URL=http://localhost:11434/v1
MEMORY_EMBED_MODEL=nomic-embed-text

# Optional supervised local session worker. Capture stays durable if this is off.
MEMORY_CAPTURE_RETENTION_DAYS=30
MEMORY_CAPTURE_EXCLUDE_PATHS=
MEMORY_WORKER_TOKEN_BUDGET=4000
MEMORY_WORKER_FLUSH_SECONDS=60
MEMORY_WORKER_IDLE_SECONDS=300
MEMORY_WORKER_INTERVAL_SECONDS=15
MEMORY_HANDOFF_MAX_CHARS=6000
